# Copy this file to `.env` and set a strong secret for session tokens.
# Without `SESSION_SECRET` the server uses in-memory sessions which are
# lost on restart and across instances (causes immediate logouts).

SESSION_SECRET=replace_with_a_long_random_string_here

# ── Security hardening (audit items #1, #7, #19) ─────────────────────────
# Rotate these values; never commit the real ones. See HANDOFF.md / audit list.

# SMS provider for phone-verification OTPs (Termii is Ghana-friendly; or Twilio)
# TERMII_API_KEY=your_termii_key
# TERMII_SENDER_ID=HAPPATM
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM_NUMBER=+1234567890

# Web-push VAPID keys (env only — never store the private key in the settings
# table or db.json). Generate: node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Comma-separated origins allowed to call the API cross-origin (CORS allowlist)
# ALLOWED_ORIGINS=http://localhost:9000,https://your-domain.com
